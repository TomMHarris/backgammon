# Pinned versions of everything the engine build downloads.
# Every download is checked against its SHA-256 (tarballs: scripts/fetch.sh)
# or its git commit (emsdk: scripts/emsdk-env.sh) before use.
# This file is sourced by bash and zsh: keep it to plain KEY=value lines.
#
# Not pinned here: host tools (meson, ninja, pkg-config, python3, curl, make,
# patch, node for the tests). See engine/README.md for the versions needed.

# Emscripten SDK. scripts/emsdk-env.sh clones the emsdk repository into
# engine/.emsdk at exactly this commit (= its git tag 7.0.0) and installs SDK
# release EMSDK_VERSION with it. Pinning the emsdk checkout matters because
# its manifest decides which node/python/LLVM builds "emsdk install" fetches.
EMSDK_VERSION=7.0.0
EMSDK_GIT_URL=https://github.com/emscripten-core/emsdk.git
EMSDK_GIT_COMMIT=1693ce7359fc9694f198694f902a2cc061239b86

# GNU Backgammon: official GNU release, GPG-verified in Phase 0 (see NOTES.md)
GNUBG_VERSION=1.08.003
GNUBG_URL=https://ftp.gnu.org/gnu/gnubg/gnubg-release-1.08.003-sources.tar.gz
# Fallback: GNU's official mirror redirector (safe because of the SHA-256 check).
GNUBG_MIRROR_URL=https://ftpmirror.gnu.org/gnubg/gnubg-release-1.08.003-sources.tar.gz
GNUBG_SHA256=6f7d969b13cfff786fba90ff8cc5e5d564b97f4f0aa69afe4f3838f18c445979

# glib: official GNOME release; checksum from glib-2.90.1.sha256sum on download.gnome.org
GLIB_VERSION=2.90.1
GLIB_URL=https://download.gnome.org/sources/glib/2.90/glib-2.90.1.tar.xz
GLIB_SHA256=93c941aa17d5eb1d53fe838365f29a8b4e539c222a256d974ec8f30fc413e396

# glib's own dependencies, built by meson as "subprojects". glib's tarball
# pins them in glib/subprojects/*.wrap (URL + SHA-256 of a source tarball and
# of a small meson build-file "patch" zip from wrapdb). We download them here,
# with the same hashes, so that every download goes through fetch.sh's checks
# and meson runs offline (--wrap-mode=nodownload). fetch.sh stops with an error
# if glib's .wrap files ever ask for different files than these.
# Only PCRE2 ends up in gnubg.wasm; libffi and zlib are needed by glib's
# meson.build (for gobject/gio) but are never compiled for our targets.
PCRE2_VERSION=10.46
PCRE2_FILE=pcre2-10.46.tar.bz2
PCRE2_URL=https://github.com/PCRE2Project/pcre2/releases/download/pcre2-10.46/pcre2-10.46.tar.bz2
PCRE2_MIRROR_URL=https://github.com/mesonbuild/wrapdb/releases/download/pcre2_10.46-1/pcre2-10.46.tar.bz2
PCRE2_SHA256=15fbc5aba6beee0b17aecb04602ae39432393aba1ebd8e39b7cabf7db883299f
PCRE2_PATCH_FILE=pcre2_10.46-1_patch.zip
PCRE2_PATCH_URL=https://wrapdb.mesonbuild.com/v2/pcre2_10.46-1/get_patch
PCRE2_PATCH_MIRROR_URL=https://github.com/mesonbuild/wrapdb/releases/download/pcre2_10.46-1/pcre2_10.46-1_patch.zip
PCRE2_PATCH_SHA256=761d16c89b9c13812842916b7ee970650ee7c1810f83bc567351faf7365b66be

LIBFFI_FILE=libffi-3.5.2.tar.gz
LIBFFI_URL=https://github.com/libffi/libffi/releases/download/v3.5.2/libffi-3.5.2.tar.gz
LIBFFI_MIRROR_URL=https://github.com/mesonbuild/wrapdb/releases/download/libffi_3.5.2-1/libffi-3.5.2.tar.gz
LIBFFI_SHA256=f3a3082a23b37c293a4fcd1053147b371f2ff91fa7ea1b2a52e335676bac82dc
LIBFFI_PATCH_FILE=libffi_3.5.2-1_patch.zip
LIBFFI_PATCH_URL=https://wrapdb.mesonbuild.com/v2/libffi_3.5.2-1/get_patch
LIBFFI_PATCH_MIRROR_URL=https://github.com/mesonbuild/wrapdb/releases/download/libffi_3.5.2-1/libffi_3.5.2-1_patch.zip
LIBFFI_PATCH_SHA256=1ee3035d92e4df3541d0b2b8d192d2fa183b46e4a3d68c00d8f71ede354bee74

ZLIB_FILE=zlib-1.3.1.tar.gz
ZLIB_URL=https://zlib.net/fossils/zlib-1.3.1.tar.gz
ZLIB_MIRROR_URL=https://github.com/mesonbuild/wrapdb/releases/download/zlib_1.3.1-1/zlib-1.3.1.tar.gz
ZLIB_SHA256=9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23
ZLIB_PATCH_FILE=zlib_1.3.1-1_patch.zip
ZLIB_PATCH_URL=https://wrapdb.mesonbuild.com/v2/zlib_1.3.1-1/get_patch
ZLIB_PATCH_MIRROR_URL=https://github.com/mesonbuild/wrapdb/releases/download/zlib_1.3.1-1/zlib_1.3.1-1_patch.zip
ZLIB_PATCH_SHA256=e79b98eb24a75392009cec6f99ca5cdca9881ff20bfa174e8b8926d5c7a47095

# cJSON (MIT): JSON in/out for our C API. No signed releases; checksum is of
# GitHub's tag archive, recorded when first downloaded.
CJSON_VERSION=1.7.19
CJSON_URL=https://github.com/DaveGamble/cJSON/archive/refs/tags/v1.7.19.tar.gz
CJSON_SHA256=7fa616e3046edfa7a28a32d5f9eacfd23f92900fe1f8ccd988c1662f30454562
