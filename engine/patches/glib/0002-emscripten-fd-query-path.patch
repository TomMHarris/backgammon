Emscripten defines none of the platform macros this function checks, so its #error fires.
(Emscripten's filesystem does provide /proc/self/fd, so the Linux branch could work, but
nothing in libglib calls this function; only gio does, and we don't build gio.)
Return G_FILE_ERROR_NOSYS, as glib already does on GNU/Hurd. gnubg never calls it.

--- a/glib/glib-unix.c	2026-11-10 15:14:21
+++ b/glib/glib-unix.c	2026-11-10 15:14:21
@@ -1006,6 +1006,11 @@
   g_set_error (error, G_FILE_ERROR, G_FILE_ERROR_NOSYS,
                "g_unix_fd_query_path() not supported on HURD");
   return NULL;
+#elif defined (__EMSCRIPTEN__)
+  /* gnubg-web: no /proc or F_GETPATH in Emscripten; report "not supported" like HURD. */
+  g_set_error (error, G_FILE_ERROR, G_FILE_ERROR_NOSYS,
+               "g_unix_fd_query_path() not supported on Emscripten");
+  return NULL;
 #else
   #error "g_unix_fd_query_path() not supported on this platform"
 #endif
