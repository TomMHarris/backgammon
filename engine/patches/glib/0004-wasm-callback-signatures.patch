Fix function-pointer casts that change the number of arguments.

g_list/g_slist/g_queue *_free_full, g_async_queue_unref, and the non-"_with_data"
sort / insert_sorted functions call a callback through a type with a different
number of arguments than it really has. That is harmless on native CPUs but
WebAssembly checks every indirect call and traps ("null function or function
signature mismatch"). This is the crash Hwa avoided by not calling
g_markup_parse_context_free(). Here each callback is called through a small
trampoline with the correct signature instead. Behaviour is unchanged.

That includes a NULL callback (a caller bug: these parameters are not
nullable). Where glib checks for one (g_list_insert_sorted and
g_slist_insert_sorted via their *_real helper, g_queue_free_full via
g_queue_foreach), the trampoline is passed only when there is a callback, so
glib's g_return_*_if_fail check still sees the NULL and logs a CRITICAL, as
upstream does. g_queue_clear_full and g_async_queue_unref test for NULL
themselves. The remaining functions have no check upstream either: a NULL
callback is called, and crashes, with or without this patch.

--- a/glib/glist.c	2026-11-10 16:25:25
+++ b/glib/glist.c	2026-11-10 16:25:47
@@ -155,11 +155,32 @@
  *
  * Since: 2.28
  */
+/* gnubg-web: call a GDestroyNotify (1 argument) through its real type.
+ * Casting it to GFunc (2 arguments) works on native CPUs but traps in
+ * WebAssembly, which checks the signature of every indirect call. */
+static void
+destroy_notify_trampoline (gpointer data,
+                           gpointer user_data)
+{
+  ((GDestroyNotify) user_data) (data);
+}
+
+/* gnubg-web: call a GCompareFunc (2 arguments) through its real type;
+ * the *_real helpers call their function as a 3-argument GCompareDataFunc,
+ * which traps in WebAssembly. The GCompareFunc travels in user_data. */
+static gint
+compare_func_trampoline (gconstpointer a,
+                         gconstpointer b,
+                         gpointer      user_data)
+{
+  return ((GCompareFunc) user_data) (a, b);
+}
+
 void
 g_list_free_full (GList          *list,
                   GDestroyNotify  free_func)
 {
-  g_list_foreach (list, (GFunc) free_func, NULL);
+  g_list_foreach (list, destroy_notify_trampoline, (gpointer) free_func);
   g_list_free (list);
 }
 
@@ -1086,7 +1107,11 @@
                       gpointer      data,
                       GCompareFunc  func)
 {
-  return g_list_insert_sorted_real (list, data, (GFunc) func, NULL);
+  /* gnubg-web: pass the trampoline only when there is a callback, so a NULL
+   * func still reaches g_list_insert_sorted_real's g_return_val_if_fail check. */
+  return g_list_insert_sorted_real (list, data,
+                                    func ? (GFunc) compare_func_trampoline : NULL,
+                                    (gpointer) func);
 }
 
 /**
@@ -1217,7 +1242,7 @@
 g_list_sort (GList        *list,
              GCompareFunc  compare_func)
 {
-  return g_list_sort_real (list, (GFunc) compare_func, NULL);
+  return g_list_sort_real (list, (GFunc) compare_func_trampoline, (gpointer) compare_func);
 }
 
